# Local env seed file/scripts
.env*

# Project paths
pack/
dist/

# Log, cache and other local, special purpose dirs hidden from SCM et al
.local/agent
.local/build
.local/cache
.local/etc
.local/log
.local/mnt
.local/sync
.local/user/data
