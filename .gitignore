*~
.*sw[a-p]
*.tmp

# Aider's one path that doesn't seem to configure externally?
.aider.tags.cache.v4
# .aider/

# Object files
*.o
*.os
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.def
*.exp

# Shared objects (inc. Windows DLLs)
*.dll
